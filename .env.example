# Base URL of your ComfyUI instance. No trailing slash.
# Running the app on the ComfyUI machine itself, this default is right.
# For a Vercel deployment it must be a PUBLIC address (see docs/setup.md,
# "Make ComfyUI reachable") — localhost means nothing to Vercel's servers.
COMFY_URL=http://127.0.0.1:8188

# Token for the ComfyUI-Login custom node. Sent as `Authorization: Bearer <token>`
# on every ComfyUI call. It is the first line of login/PASSWORD in your ComfyUI
# folder (also printed in the ComfyUI console) — not the password itself.
#
# IMPORTANT: escape every `$` as `\$` here. dotenv treats `$2b` as a variable
# reference and would silently blank it out. So a console token of
#   $2b$12$AbCdEf...
# must be written:
#   COMFY_API_TOKEN=\$2b\$12\$AbCdEf...
# Values set in the Vercel dashboard or via `vercel env add` are literal — do NOT
# escape them there.
COMFY_API_TOKEN=

# Optional: only if ComfyUI sits behind a separate proxy instead of the login node.
# COMFY_BASIC_AUTH takes precedence over COMFY_API_TOKEN.
# COMFY_BASIC_AUTH=user:password
# COMFY_AUTH_HEADER_NAME=X-Api-Key
# COMFY_AUTH_HEADER_VALUE=

# The app's password: what you type at the gate of the deployed app. When set,
# every /api/* call must present it and the UI prompts for it once per tab.
# Leave unset for an open app (fine locally, never for a public deployment).
# There is no default. Generate one with either of:
#   openssl rand -hex 32
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
APP_ACCESS_TOKEN=

# How long a single generation may run before the UI gives up, in seconds.
GENERATION_TIMEOUT_SECONDS=1800
